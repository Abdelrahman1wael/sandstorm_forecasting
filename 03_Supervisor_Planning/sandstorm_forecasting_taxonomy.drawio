                <mxCell id="21" value="&lt;b&gt;2.1 Small Scale (Microscale &amp;amp; Short-Term)&lt;/b&gt;&lt;br/&gt;• Spatial: &amp;lt; 2 km (boundary layer turbulence, dust devils)&lt;br/&gt;• Temporal: 0–72 h nowcasting &amp;amp; airport runway alert (KKIA)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ECFDF5;strokeColor=#6EE7B7;strokeWidth=1;fontColor=#064E3B;fontFamily=Helvetica;fontSize=11;align=left;spacingLeft=8;spacingRight=8;" parent="1" vertex="1">
                    <mxGeometry x="450" y="230" width="360" height="68" as="geometry"/>
                </mxCell>
                <mxCell id="22" value="&lt;b&gt;2.2 Medium Scale (Mesoscale &amp;amp; Extended)&lt;/b&gt;&lt;br/&gt;• Spatial: 2–2,000 km (convective Haboob dust walls)&lt;br/&gt;• Temporal: &lt;b&gt;3–15 days (Sub-seasonal) — Core Innovation!&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFBEB;strokeColor=#FCD34D;strokeWidth=1.5;fontColor=#78350F;fontFamily=Helvetica;fontSize=11;align=left;spacingLeft=8;spacingRight=8;" parent="1" vertex="1">
