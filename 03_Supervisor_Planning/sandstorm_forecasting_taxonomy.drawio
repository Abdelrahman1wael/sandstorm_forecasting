                <mxCell id="49" value="&lt;b&gt;5.1 Pillar 1: Meteorological AI &amp;amp; PINN&lt;/b&gt;&lt;br&gt;• Dual-line: Line A GBDT ensembles + Line B Deep LSTM/transformer/ST-GNN&lt;br&gt;• Extended 3–15 days forecast with P10/P50/P90 confidence" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F0FDFA;strokeColor=#5EEAD4;strokeWidth=1;fontColor=#134E4A;fontFamily=Helvetica;fontSize=11;align=left;spacingLeft=8;spacingRight=8;" parent="1" vertex="1">
