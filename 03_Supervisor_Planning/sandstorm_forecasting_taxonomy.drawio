                <mxCell id="32" value="&lt;b&gt;3.4 NWP Bias Correction &amp;amp; Quantiles&lt;/b&gt;&lt;br/&gt;• Residual learning: y_true = NWP + f_GBDT(X_features)&lt;br/&gt;• Pinball loss uncertainty envelopes: P10, P50, P90" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F0F9FF;strokeColor=#7DD3FC;strokeWidth=1;fontColor=#0C4A6E;fontFamily=Helvetica;fontSize=11;align=left;spacingLeft=8;spacingRight=8;" parent="1" vertex="1">
