                </mxCell>
                <mxCell id="15" value="&lt;b&gt;1.3 Dynamical NWP &amp;amp; Chemistry Models&lt;/b&gt;&lt;br/&gt;• ECMWF IFS, CMA-GFS, WRF-Chem, CAMS&lt;br/&gt;• Discretized Navier-Stokes &amp;amp; aerosol continuity PDEs" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FAF5FF;strokeColor=#D8B4FE;strokeWidth=1;fontColor=#3B0764;fontFamily=Helvetica;fontSize=11;align=left;spacingLeft=8;spacingRight=8;" parent="1" vertex="1">
