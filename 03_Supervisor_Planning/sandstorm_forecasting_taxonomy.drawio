                <mxCell id="24" value="&lt;b&gt;2.4 5-Tier Hazard Classification&lt;/b&gt;&lt;br/&gt;• Level 1 (Normal) &amp;rarr; Level 3 (Blowing sand: 150–500 ug/m³)&lt;br/&gt;• Level 4–5 (Severe blackout Haboob: &amp;gt;2,000–5,000+ ug/m³)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFBEB;strokeColor=#FCD34D;strokeWidth=1.5;fontColor=#78350F;fontFamily=Helvetica;fontSize=11;align=left;spacingLeft=8;spacingRight=8;" parent="1" vertex="1">
