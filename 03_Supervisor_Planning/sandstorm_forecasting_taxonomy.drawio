                <mxCell id="29" value="&lt;b&gt;3.1 Classical ML (Literature Cited)&lt;/b&gt;&lt;br/&gt;• Artificial Neural Networks (ANN / Multi-Layer Perceptrons)&lt;br/&gt;• Support Vector Machines (SVM) with 500 hPa potential fields" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F0F9FF;strokeColor=#7DD3FC;strokeWidth=1;fontColor=#0C4A6E;fontFamily=Helvetica;fontSize=11;align=left;spacingLeft=8;spacingRight=8;" parent="1" vertex="1">
                    <mxGeometry x="850" y="230" width="360" height="68" as="geometry"/>
                </mxCell>
                <mxCell id="30" value="&lt;b&gt;3.2 GBDT Tree Ensembles&lt;/b&gt;&lt;br/&gt;• LightGBM (fast leaf-wise histogram splits)&lt;br/&gt;• CatBoost (ordered boosting) &amp;amp; XGBoost regularized trees" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F0F9FF;strokeColor=#7DD3FC;strokeWidth=1;fontColor=#0C4A6E;fontFamily=Helvetica;fontSize=11;align=left;spacingLeft=8;spacingRight=8;" parent="1" vertex="1">
                    <mxGeometry x="850" y="310" width="360" height="68" as="geometry"/>
                </mxCell>
                <mxCell id="31" value="&lt;b&gt;3.3 Imbalance &amp;amp; Cost-Sensitive Learning&lt;/b&gt;&lt;br/&gt;• SMOTE minority oversampling for &amp;lt;3% rare storm days&lt;br/&gt;• Focal Loss down-weighting easy normal weather samples" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F0FDFA;strokeColor=#5EEAD4;strokeWidth=1.5;fontColor=#134E4A;fontFamily=Helvetica;fontSize=11;align=left;spacingLeft=8;spacingRight=8;" parent="1" vertex="1">
