                <mxCell id="13" value="&lt;b&gt;1.1 Subjective Synoptic Analysis&lt;/b&gt;&lt;br/&gt;• Manual surface weather isobaric charts&lt;br/&gt;• 500 hPa geopotential troughs &amp;amp; 850 hPa wind convergence" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FAF5FF;strokeColor=#D8B4FE;strokeWidth=1;fontColor=#3B0764;fontFamily=Helvetica;fontSize=11;align=left;spacingLeft=8;spacingRight=8;" parent="1" vertex="1">
                    <mxGeometry x="50" y="230" width="360" height="68" as="geometry"/>
                </mxCell>
                <mxCell id="14" value="&lt;b&gt;1.2 Classical Empirical Saltation&lt;/b&gt;&lt;br/&gt;• Bagnold (1941) sand flux: q ~ u*³&lt;br/&gt;• Owen (1964) saltation threshold gate: u* &amp;gt; u*t" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FAF5FF;strokeColor=#D8B4FE;strokeWidth=1;fontColor=#3B0764;fontFamily=Helvetica;fontSize=11;align=left;spacingLeft=8;spacingRight=8;" parent="1" vertex="1">
