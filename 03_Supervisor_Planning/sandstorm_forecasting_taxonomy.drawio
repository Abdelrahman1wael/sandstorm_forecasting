                <mxCell id="39" value="&lt;b&gt;4.1 Long Short-Term Memory (LSTM)&lt;/b&gt;&lt;br/&gt;• Recurrent temporal gating for dust sequence memory&lt;br/&gt;• Bi-directional GRU/LSTM with temporal attention weights" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EEF2FF;strokeColor=#A5B4FC;strokeWidth=1;fontColor=#1E1B4B;fontFamily=Helvetica;fontSize=11;align=left;spacingLeft=8;spacingRight=8;" parent="1" vertex="1">
