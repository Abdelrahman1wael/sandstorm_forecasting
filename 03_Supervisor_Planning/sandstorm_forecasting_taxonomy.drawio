                <mxCell id="2" value="&lt;b&gt;🌪️ SAND &amp;amp; DUST STORM (SDS) FORECASTING TAXONOMY SITEMAP&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:11px; font-weight:normal;'&gt;Hierarchical Classification of Methodologies in Literature Review &amp;amp; Master Research Proposal&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#1E293B;strokeColor=#38BDF8;strokeWidth=2;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=14;fontStyle=1;align=center;" parent="1" vertex="1">
