                <mxCell id="23" value="&lt;b&gt;2.3 Large Scale (Synoptic &amp;amp; Seasonal)&lt;/b&gt;&lt;br/&gt;• Spatial: &amp;gt; 2,000 km (prolonged regional Shamal regimes)&lt;br/&gt;• Temporal: &amp;gt; 15–90+ days (teleconnections: ENSO, NAO, AO)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FEF2F2;strokeColor=#FCA5A5;strokeWidth=1;fontColor=#7F1D1D;fontFamily=Helvetica;fontSize=11;align=left;spacingLeft=8;spacingRight=8;" parent="1" vertex="1">
